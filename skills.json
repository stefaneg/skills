{
  "$comment": "The manifest. This file is the single source of truth for which skills exist on this machine and how visible each one is. Edit it, then run `bin/skills sync`.",
  "targets": [
    "~/.claude/skills",
    "~/.agents/skills"
  ],
  "projects": {
    "axis": {
      "root": "../axis",
      "install": []
    }
  },
  "sources": {
    "own": {
      "type": "local",
      "path": "skills"
    },
    "mattpocock": {
      "type": "github",
      "repo": "mattpocock/skills",
      "ref": "main"
    },
    "superpowers": {
      "type": "github",
      "repo": "obra/superpowers",
      "ref": "main"
    },
    "vercel": {
      "type": "github",
      "repo": "vercel-labs/skills",
      "ref": "main"
    },
    "herdr": {
      "type": "github",
      "repo": "herdrdev/herdr",
      "ref": "master"
    },
    "cursor": {
      "type": "github",
      "repo": "cursor/plugins",
      "ref": "main"
    }
  },
  "install": [
    {
      "skill": "roundtable-review",
      "source": "own",
      "tier": "on-demand"
    },
    {
      "skill": "grill-me",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "grill-with-docs",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "diagnosing-bugs",
      "source": "mattpocock",
      "tier": "auto"
    },
    {
      "skill": "tdd",
      "source": "mattpocock",
      "tier": "auto"
    },
    {
      "skill": "triage",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "$comment": "The primitive grill-me and grill-with-docs both run on, and the two vocabulary layers other skills pull in. Model-invoked upstream, so auto.",
      "skill": "grilling",
      "source": "mattpocock",
      "tier": "auto"
    },
    {
      "skill": "domain-modeling",
      "source": "mattpocock",
      "tier": "auto"
    },
    {
      "skill": "codebase-design",
      "source": "mattpocock",
      "tier": "auto"
    },
    {
      "$comment": "disable-model-invocation upstream — typed, never picked.",
      "skill": "ask-matt",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "implement",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "setup-matt-pocock-skills",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "code-review",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "pr",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "improve-codebase-architecture",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "prototype",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "to-tickets",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "to-spec",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "handoff",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "$comment": "Renamed upstream from writing-great-skills.",
      "skill": "writing-for-agents",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "wayfinder",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "$comment": "Feeds the main flow at grill-with-docs. Typed, not picked.",
      "skill": "research",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "$comment": "disable-model-invocation upstream — typed, never picked.",
      "skill": "teach",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "$comment": "One-line interrupt: /wait-what re-pitches the last message. disable-model-invocation upstream — typed, never picked.",
      "skill": "wait-what",
      "source": "mattpocock",
      "tier": "on-demand"
    },
    {
      "skill": "find-skills",
      "source": "vercel",
      "tier": "on-demand"
    },
    {
      "skill": "herdr",
      "source": "herdr",
      "tier": "on-demand"
    },
    {
      "skill": "reflect",
      "source": "cursor",
      "tier": "on-demand"
    },
    {
      "skill": "technical-writing",
      "source": "cursor",
      "tier": "on-demand"
    }
  ]
}
